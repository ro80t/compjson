{
  "name": "compjson",
  "version": "0.0.0",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.mts",
      "import": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsdown",
    "lint": "oxfmt --check ./ && oxlint ./",
    "lint:fix": "oxlint --fix ./",
    "format": "oxfmt ./",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@toon-format/toon": "^4.1.1"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@types/bun": "1.3.14",
    "@types/node": "24.1.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "tsdown": "^0.22.14",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  }
}
